# Anthropic API key for Deep AI Analysis feature
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# PostgreSQL connection string (local + Railway)
# On Railway: provision the PostgreSQL plugin and it injects this automatically.
DATABASE_URL=

# --- Auth ---
# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`)
AUTH_SECRET=
# Admin login, seeded into the users table on first boot
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Kalshi trading (both values come from kalshi.com -> Account -> API keys) ---
KALSHI_API_KEY_ID=
# Base64-encoded RSA private key PEM (base64 avoids newline issues in env vars):
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("kalshi-key.pem"))
KALSHI_PRIVATE_KEY_BASE64=
# Safety cap on contracts per order
MAX_ORDER_CONTRACTS=100

# --- AI ---
# Model used for Deep AI Analysis and AI Advantage summaries
ANALYZE_MODEL=claude-sonnet-4-5

# --- Automation ---
# Shared secret for the external cron triggers (e.g. `openssl rand -hex 32`).
# Point your cron service at:
#   GET /api/cron/auto-trade?secret=<CRON_SECRET>          (weather bot, every 5-10 min)
#   GET /api/cron/crypto-auto-trade?secret=<CRON_SECRET>   (crypto bot, every 5 min)
# Both engines refuse to run while this is unset.
CRON_SECRET=

# --- Crypto section ---
# Crypto market data uses free public APIs — no keys needed:
#   Coinbase Exchange (spot + 1m candles, primary), Kraken (fallback),
#   Deribit DVOL (implied volatility).
# Optional model override for suggestion reviews (weather + crypto):
# REVIEW_MODEL=claude-sonnet-4-5
